# Allow only portable workspace files. This also excludes nested checkouts,
# local databases, EDT state, indexes, backups, credentials and test output.
# Tracked files are unaffected by these ignore rules.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/WORKSPACE-RULES.md
!/1C-RULES.md
!/adapter/
!/conversion/
!/tests/

/adapter/*
!/adapter/AGENTS.md
!/adapter/.agents/
/adapter/.agents/*
!/adapter/.agents/skills/
/adapter/.agents/skills/*
!/adapter/.agents/skills/onec-mcp-toolkit/
!/adapter/.ai/
!/adapter/.codex/
/adapter/.ai/*
!/adapter/.ai/.gitignore
!/adapter/.ai/PROJECT.md
!/adapter/.ai/project.yaml
/adapter/.codex/*
!/adapter/.codex/config.toml

/conversion/*
!/conversion/AGENTS.md
!/conversion/.ai/
/conversion/.ai/*
!/conversion/.ai/.gitignore
!/conversion/.ai/PROJECT.md
!/conversion/.ai/project.yaml

/tests/*
!/tests/AGENTS.md
!/tests/.agents/
/tests/.agents/*
!/tests/.agents/skills/
/tests/.agents/skills/*
!/tests/.agents/skills/kafka-docker-tests/
/tests/.agents/skills/kafka-docker-tests/*
!/tests/.agents/skills/kafka-docker-tests/SKILL.md
!/tests/.ai/
/tests/.ai/*
!/tests/.ai/.gitignore
!/tests/.ai/FIXTURES.md
!/tests/.ai/PROJECT.md
!/tests/.ai/project.yaml
!/tests/.codex/
/tests/.codex/*
!/tests/.codex/config.toml
!/tests/scripts/
/tests/scripts/*
!/tests/scripts/docker-ci/
/tests/scripts/docker-ci/*
!/tests/scripts/docker-ci/create_ci_infobase.py
!/tests/scripts/docker-ci/run_ui_docker.py
